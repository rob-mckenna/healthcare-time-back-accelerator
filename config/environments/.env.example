# -----------------------------------------------------------------------------
# Second Shift Reduction Accelerator — environment value template
#
# Copy to .env and fill in for your own environment. Never commit .env.
# This file carries variable NAMES and placeholder shapes only. It must never
# carry a real endpoint, tenant identifier, subscription identifier, key,
# token, password, or connection string.
#
# Organization packs under config/organizations/<id>/organization.json refer to
# these variables by name through their environmentBindings block. That is why a
# committed configuration file can never contain an environment value.
# -----------------------------------------------------------------------------

# Which organization pack to load, e.g. harborlight
ORGANIZATION_ID=<organization-pack-id>

# Azure deployment region for the environment, e.g. a region short name
AZURE_REGION=<azure-region>

# Microsoft Foundry project endpoint for the Shift Closeout Agent
FOUNDRY_PROJECT_ENDPOINT=<foundry-project-endpoint>

# Identifier of the single Shift Closeout Agent deployment
FOUNDRY_AGENT_ID=<foundry-agent-id>

# Power Platform environment hosting the Copilot Studio experience
COPILOT_ENVIRONMENT_ID=<copilot-environment-id>

# Where minimal audit events are written in this environment
AUDIT_EVENT_SINK=<audit-event-sink>

# Where approval events are written in this environment
APPROVAL_EVENT_SINK=<approval-event-sink>

# -----------------------------------------------------------------------------
# Credentials
#
# No credential belongs in this repository, in .env.example, or in any
# organization pack. Use a managed identity or a secret store for the
# connector and agent identities. If a credential is ever committed, treat it
# as exposed: revoke it, rotate it, and report it before continuing.
# -----------------------------------------------------------------------------
