  "cases": [
    {
      "name": "requester carries a display name alongside a valid actorRef",
      "handoff": {
        "requester": {
          "actorRef": "USR-RN0000000001",
          "roleCode": "registered-nurse",
          "authenticated": true,
          "displayName": "Sample Nurse Testcase"
        }
      }
    },
    {
      "name": "requester carries an email address",
      "handoff": {
        "requester": {
          "actorRef": "USR-RN0000000001",
          "roleCode": "registered-nurse",
          "authenticated": true,
          "email": "nurse.testcase@hospital.example"
        }
      }
    },
    {
      "name": "requester carries a bearer token",
      "handoff": {
        "requester": {
          "actorRef": "USR-RN0000000001",
          "roleCode": "registered-nurse",
          "authenticated": true,
          "accessToken": "PLACEHOLDER-NOT-A-REAL-TOKEN"
